# Leave empty to run the bundled offline generation engine (no API calls, fully
# deterministic, streams exactly like the real thing). Set a key to route
# generation through Claude instead.
ANTHROPIC_API_KEY=

# Model used when ANTHROPIC_API_KEY is present.
SYNTHESISE_MODEL=claude-sonnet-5

# Where generated offers are persisted (JSON file store). Defaults to ./.data
SYNTHESISE_DATA_DIR=
